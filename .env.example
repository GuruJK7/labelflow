# -- BASE DE DATOS --
DATABASE_URL=postgresql://postgres:password@localhost:5432/labelflow
DIRECT_URL=postgresql://postgres:password@localhost:5432/labelflow

# -- SUPABASE --
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=labels

# -- AUTH --
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-con-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Alta pública (self-serve). Default APAGADO: sin esto, POST /api/auth/signup
# devuelve 403 y el alta nueva por Google se rechaza (lib/auth.ts). Poner
# "true" en Vercel para abrir el registro (D22).
ALLOW_PUBLIC_SIGNUP=
# Si es "true"/"1", el dashboard y /onboarding exigen email confirmado
# (redirigen a /verify-email). Prenderla SOLO con RESEND_API_KEY viva: si el
# mail no sale, el usuario nuevo queda encerrado (D23).
EMAIL_VERIFICATION_REQUIRED=
# Resend: mails transaccionales (confirmar email, reset de contraseña). Sin
# la key el alta sigue funcionando pero no sale ningún mail (soft-fail).
RESEND_API_KEY=
# Remitente opcional (debe estar verificado en Resend). Default:
# "LabelFlow <noreply@autoenvia.com>".
RESEND_FROM=

# -- REDIS (UPSTASH) --
REDIS_URL=redis://localhost:6379

# -- STRIPE --
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx

# -- ENCRYPTION --
ENCRYPTION_KEY=genera-32-bytes-hex-con-openssl-rand-hex-32

# -- ADMIN ACCESS --
# Emails con rol admin (D32), separados por coma, insensible a mayúsculas y
# espacios. Sin la var NADIE es admin: el menú muestra sólo Dashboard, Etiquetas
# y Configuración, y /control, /orders, /reports y /admin responden 404. Con
# ella, ese usuario ve todo y Control lista además las tiendas activas de todos
# los clientes (revisión 2026-09-02). Se lee de la fila del User, no del JWT.
# Fallback: ADMIN_EMAIL (un solo email). No es secreto. En Vercel (producción)
# ya está cargada con admin@autoenvia.com y el gmail de Adrian.
ADMIN_EMAILS=
ADMIN_EMAIL=
ADMIN_TENANT_IDS=                      # Comma-separated tenant IDs that can see all reports (e.g. id1,id2,id3)

# -- AUTOENVÍA PROVISIONING (self-service DAC tenants) --
# Secreto que AutoEnvía usa para llamar a POST /api/provisioning/dac-tenant.
# Debe coincidir con LABELFLOW_PROVISION_TOKEN en AutoEnvía. Fail-closed: si está
# vacío, el endpoint rechaza TODO (openssl rand -hex 32).
AUTOENVIA_PROVISION_TOKEN=
# Opcional: si se setea, el endpoint exige además firma HMAC (X-Timestamp +
# X-Signature = HMAC-SHA256(key, `${ts}.${rawBody}`)). Debe coincidir con
# LABELFLOW_PROVISION_SIGNING_KEY en AutoEnvía (openssl rand -hex 32).
AUTOENVIA_PROVISION_SIGNING_KEY=

# -- WORKER --
WORKER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true
LABELS_TMP_DIR=/tmp/labelflow

# -- MCP --
MCP_SECRET=genera-con-openssl-rand-base64-32

# -- WHATSAPP (Recover Module) --
WHATSAPP_API_TOKEN=                    # Meta Cloud API permanent token
WHATSAPP_PHONE_NUMBER_ID=             # ID del numero en Meta Business
WHATSAPP_BUSINESS_ACCOUNT_ID=         # WABA ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=        # Token aleatorio para verificacion webhook Meta (openssl rand -hex 24)
WHATSAPP_APP_SECRET=                  # App Secret de Meta (para verificar firma HMAC en webhooks POST)
RECOVER_MERCADOPAGO_PLAN_ID=          # ID del plan de suscripcion en MercadoPago
MERCADOPAGO_WEBHOOK_SECRET=           # Webhook signing secret from MercadoPago (required — rejects all webhooks if unset)

# -- PRECIOS EN DOLARES (D35) --
# Tipo de cambio UYU por USD con el que MercadoPago cobra en pesos lo que esta
# denominado en dolares. Hasta 3 decimales, punto o coma ("41", "41.5", "38.875").
# Rango aceptado: 1 a 1000. Valor ilegible = un console.error y se cobra al tipo
# base (40), que es el numero del que salio la escalera de D35. NO es la cotizacion
# del dia: ponerlo al valor real es decision de Adrian, y subirlo sube lo que paga
# en pesos TODO cliente actual (a 44 suben los seis escalones viejos).
# El ledger del worker NO lee esta var: usa el tipo base fijo (ver
# apps/worker/src/billing/tiers.ts, BASE_USD_UYU_RATE_MILLI).
# GUARDARRAIL: si el valor sube el precio en pesos de algun escalon viejo mas
# alla de la excepcion ya asumida por D35 (la de 1000 envios), el primer checkout
# deja un console.error "[pricing] ALERTA DE PRECIO" nombrando cada escalon que
# sube, cuanto sube y el techo (38,888 UYU/USD). No bloquea el cobro: avisa.
USD_UYU_RATE=

# Habilita la compra en AUTOSERVICIO de pack_2500 (USD 350) y pack_5000 (USD 550).
# Solo el string exacto "true". Apagada (el default) el catalogo queda en los seis
# de siempre y el checkout rechaza esos ids aunque se escriban a mano.
# POR QUE ESTA APAGADA: un paquete cobra el precio del escalon aplicado al TAMANO
# DEL PACK y los envios no vencen, asi que comprar grande compra un precio bajo
# PARA SIEMPRE sin tener nunca ese volumen mensual. El techo de ese descuento era
# 64% (pack_1000 a 0,18) y con estos dos pasa a 78% (pack_5000 a 0,11).
# Medido: un cliente de 60 envios/mes paga USD 550 por lo que a su volumen real
# serian USD 2.100 en los 83 meses que le duran los envios (-73,8%).
# Prenderla es decision comercial de Adrian: ver PENDIENTES.md, seccion D35.
ENABLE_LARGE_CREDIT_PACKS=

# -- WHOP (segundo riel de packs, D34) --
# JSON {packId: url de checkout}. Sin la var (o sin el pack) el boton de Whop no aparece.
# Ej: {"pack_100":"https://whop.com/checkout/plan_xxx","pack_500":"https://whop.com/checkout/plan_yyy"}
WHOP_CHECKOUT_URLS=
# Secret del webhook de Whop (Standard Webhooks, viene como whsec_...). Sin esto el webhook responde 503.
WHOP_WEBHOOK_SECRET=
# JSON {packId: plan_id de Whop} o {packId: {"planId": "...", "minUsd": N}}. El webhook SOLO acredita si el
# plan/producto que trae el pago es el del pack de la compra (y, con minUsd, si el monto en USD llega al piso).
# Sin esta var ningun pago de Whop se acredita (fail-closed). No es secreto.
# Ej: {"pack_100":"plan_xxx","pack_500":{"planId":"plan_yyy","minUsd":60}}
WHOP_PLAN_IDS=

# Contrareembolso en la UI (revisión 2026-09-02). Apagada por defecto: el toggle
# del paso 4 / Configuración se muestra como "Próximamente" y PUT /api/v1/settings
# rechaza codEnabled=true (422). Prenderla (true/1) SOLO después de confirmar que el
# worker de Render corre un commit que incluya df13204 (process-orders.job.ts lee
# tenant.codEnabled). No es secreto. Las columnas ya están en prod.
COD_FEATURE_ENABLED=

# -- SHOPIFY --
# App shared secret from Shopify Partner Dashboard → Apps → [app] → App credentials.
# REQUIRED for webhook HMAC verification (C-1/C-2 fix). Same secret signs every
# webhook across every installed store — do NOT confuse with per-store Admin
# API access tokens stored in `tenant.shopifyToken`.
SHOPIFY_API_SECRET=
# client_id de la app pública. Junto con el secret, la web canjea el code y
# RENUEVA los tokens offline expirables (D29). El worker también los necesita
# para renovar por su cuenta; sin ellos avisa una vez por tenant y usa el
# access guardado (1 h).
SHOPIFY_API_KEY=
# Worker: qué Admin API usar para hablar con Shopify (D27). Default `auto`:
# tenants del App Store (slug `shop-*`) → GraphQL 2026-07; tokens de custom app
# → REST 2024-01, con conmutación a GraphQL si REST responde 403. `rest` o
# `graphql` fuerzan un camino para todos (emergencias).
SHOPIFY_API_MODE=auto

# Opcional (D33, paso 2 del onboarding): link "o instalala desde el App Store de
# Shopify". Si está vacía, el wizard no muestra ese link (el botón "Conectar
# con Shopify" alcanza). Es pública: va al cliente.
NEXT_PUBLIC_SHOPIFY_APP_STORE_URL=

# -- APP --
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=LabelFlow

# -- CLAUDE ADDRESS-CORRECTION (YELLOW/RED flow) --
# Primary path: Tailscale bridge to the Mac Mini running Claude Max ($0/call).
# If unreachable, the worker transparently falls back to the Anthropic API.
LABELFLOW_BRIDGE_URL=http://100.x.x.x:7777    # Tailscale IP of the Mac Mini
LABELFLOW_BRIDGE_SECRET=                       # Shared secret — generated by install.sh (openssl rand -hex 32)
LABELFLOW_BRIDGE_TIMEOUT_MS=120000

# Fallback: direct Anthropic API with haiku (~$0.0008/call). Always set on Render.
ANTHROPIC_API_KEY=sk-ant-api03-xxx
LABELFLOW_API_TIMEOUT_MS=30000
